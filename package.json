{
  "name": "borrowloop-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@borrowloop/api",
    "dev:worker": "npm run dev --workspace=@borrowloop/worker",
    "dev:web": "npm run dev --workspace=@borrowloop/web",
    "dev:portal": "npm run dev --workspace=@borrowloop/portal",
    "dev": "concurrently -n \"api,worker,web,portal\" -c \"blue,cyan,green,magenta\" \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\" \"npm:dev:portal\"",
    "create-admin": "node apps/api/scripts/createAdmin.js",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:ci": "node scripts/run-tests-ci.js",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^4.10.2",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^15.4.3",
    "mongodb-memory-server": "^11.3.0",
    "pino-http": "^11.0.0",
    "prettier": "^3.5.0",
    "supertest": "^7.3.1",
    "vite": "^8.3.6",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^8.9.5",
    "otpauth": "^9.6.0",
    "pino": "^10.4.0"
  }
}
